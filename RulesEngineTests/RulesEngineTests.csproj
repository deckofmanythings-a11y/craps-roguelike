<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiles the plain rules-engine files from RulesEngine/. This C# copy is
         the canonical balance-tuning spec; the shippable game uses the JS port
         in web/js/craps-rules.js. Keep the two in sync (see DESIGN notes). -->
    <Compile Include="..\RulesEngine\*.cs" />
  </ItemGroup>

</Project>
